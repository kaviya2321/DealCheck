# DealCheck Configuration Example

# PayPal Sandbox Credentials (Get from developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Gemini API Key (Optional: only for image vision OCR and Q&A advice; scoring runs 100% locally)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
DB_PATH=dealcheck.db

# Security & Authentication
JWT_SECRET=your_random_jwt_secret_hex_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# Chat Message Encryption at Rest (Fernet key generated via cryptography.fernet.Fernet.generate_key())
CHAT_ENC_KEY=your_fernet_key_here
